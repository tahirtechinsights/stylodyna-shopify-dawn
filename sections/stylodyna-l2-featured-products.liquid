{% comment %}
  StyloDyna L2 Featured Products Section (DECOR-L2-MERCH-001A)
  Reusable L2 Merchandising Landing Featured Products (New Arrivals Style Layout)
  No PLP Chrome / No Filters / No Facets / No Search / No Sort / Max 9 Products (3x3 Desktop Grid)
  Includes QA Test Product Count rendering support for 1/3/6/9 grid contract validation.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-stylodyna-l2-featured-products.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign target_collection = section.settings.collection
  if target_collection == blank and template.name == 'collection'
    assign target_collection = collection
  endif

  assign max_featured_products = 9
  assign products_to_show = section.settings.products_to_show | default: 9 | at_most: max_featured_products
  assign test_grid_count = section.settings.test_grid_count | default: 0 | at_most: max_featured_products
  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and target_collection != blank
    assign view_all_url = target_collection.url
  endif
-%}

<div class="stylodyna-l2-featured section-{{ section.id }}-padding">
  <div class="page-width">
    {%- comment -%} Clean Editorial Section Header {%- endcomment -%}
    <div class="stylodyna-l2-featured__header">
      <div class="stylodyna-l2-featured__header-left">
        {%- if section.settings.eyebrow != blank -%}
          <p class="stylodyna-l2-featured__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="stylodyna-l2-featured__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="stylodyna-l2-featured__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all and view_all_url != blank -%}
        <div class="stylodyna-l2-featured__header-right">
          <a href="{{ view_all_url }}" class="stylodyna-l2-featured__view-all">
            <span>{{ section.settings.view_all_label | default: 'View all' | escape }}</span>
            <svg class="stylodyna-l2-featured__view-all-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Product Grid: 3-Column Desktop Grid (Max 9 Products / 3 Rows) {%- endcomment -%}
    {%- if test_grid_count > 0 and target_collection != blank and target_collection.products_count > 0 -%}
      {%- assign sample_product = target_collection.products.first -%}
      <div class="stylodyna-l2-featured__grid collection-plp collection-plp--decor stylodyna-decor-plp">
        {%- for i in (1..test_grid_count) -%}
          <div class="stylodyna-l2-featured__grid-item">
            {% render 'card-product',
              card_product: sample_product,
              media_aspect_ratio: 'portrait',
              show_secondary_image: true,
              show_vendor: section.settings.show_vendor,
              show_rating: false,
              section_id: section.id,
              product_view_context: 'collection'
            %}
          </div>
        {%- endfor -%}
      </div>
    {%- elsif target_collection != blank and target_collection.products_count > 0 -%}
      <div class="stylodyna-l2-featured__grid collection-plp collection-plp--decor stylodyna-decor-plp">
        {%- for product in target_collection.products limit: products_to_show -%}
          <div class="stylodyna-l2-featured__grid-item">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'portrait',
              show_secondary_image: true,
              show_vendor: section.settings.show_vendor,
              show_rating: false,
              section_id: section.id,
              product_view_context: 'collection'
            %}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="stylodyna-l2-featured__empty">
        <p class="stylodyna-l2-featured__empty-text">No featured products currently available in this collection.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "L2 Featured Products",
  "tag": "section",
  "class": "section-stylodyna-l2-featured-products",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "FEATURED PRODUCTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Selection"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Handpicked decorative objects and botanical accents for your interior spaces.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 9,
      "step": 1,
      "default": 9,
      "label": "Maximum products to show (Max 9 / 3 rows)"
    },
    {
      "type": "range",
      "id": "test_grid_count",
      "min": 0,
      "max": 9,
      "step": 1,
      "default": 0,
      "label": "QA Test Product Count (0 = Live Collection Products)"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Link Label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Custom Link (Optional)"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "L2 Featured Products"
    }
  ]
}
{% endschema %}
