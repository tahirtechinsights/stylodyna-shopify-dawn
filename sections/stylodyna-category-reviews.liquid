        },
        {
          "type": "review_card",
          "settings": {
            "demo_badge": "Sample Review",
            "review_text": "Beautiful detailing with a polished finish. The accessory feels thoughtfully selected and easy to style.",
            "author_name": "Hira Malik",
            "author_city": "Islamabad, Pakistan",
            "avatar_asset": "sd-review-hira-malik.webp",
            "product_asset": "sd-lifestyle-womens-accessories.webp"
          }
        },
        {
          "type": "review_card",
          "settings": {
            "demo_badge": "Sample Review",
            "review_text": "Clean design, practical size and a premium finish. Exactly the everyday piece I was looking for.",
            "author_name": "Sana Ahmed",
            "author_city": "Karachi, Pakistan",
