{%- comment -%}
  StyloDyna Category Carousel Section (CAT-UI-002K Remediation)
  Reusable Level 3 Category Rail with Compact 5-Card Desktop Layout & Truthful Availability States
{%- endcomment -%}

{{ 'component-stylodyna-shop-by-categories.css' | asset_url | stylesheet_tag }}
{{ 'component-stylodyna-category-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'stylodyna-category-landing.js' | asset_url }}" defer="defer"></script>

<div class="stylodyna-category-carousel-section page-width">
  <div class="stylodyna-categories__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="stylodyna-categories__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="stylodyna-categories__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="stylodyna-categories__description rte">
        {{ section.settings.description }}
      </div>
    {%- endif -%}
  </div>

  <stylodyna-category-carousel class="stylodyna-categories__rail-wrapper">
    {%- if section.settings.show_nav_buttons -%}
      <button
        type="button"
        class="stylodyna-categories__nav-btn stylodyna-categories__nav-btn--prev"
        aria-label="Previous categories"
        disabled
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
    {%- endif -%}

    <ul
      class="stylodyna-category-carousel__rail"
      role="list"
      aria-label="{{ section.settings.heading | default: 'Explore Categories' }}"
      tabindex="0"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_title = block.settings.title
          assign is_available = false
          assign status_label = "COMING SOON"
          assign target_url = "javascript:void(0)"

          if forloop.first
            assign is_available = true
            assign status_label = "SHOP NOW"
            assign target_url = block.settings.custom_link | default: "/collections/lifestyle"
          elsif block.settings.collection != blank or block.settings.custom_link != blank
            assign is_available = true
            assign status_label = "SHOP NOW"
            assign target_url = block.settings.custom_link | default: block.settings.collection.url
          endif
        -%}
        
        <li class="stylodyna-category-carousel__item" {{ block.shopify_attributes }}>
          <a
            href="{{ target_url }}"
            class="stylodyna-category-card{% unless is_available %} stylodyna-category-card--coming-soon{% endunless %}"
            aria-label="{{ card_title | escape }} — {{ status_label }}"
            {% unless is_available %}aria-disabled="true"{% endunless %}
          >
            <span class="stylodyna-category-card__badge {% if is_available %}stylodyna-category-card__badge--available{% else %}stylodyna-category-card__badge--coming-soon{% endif %}">
              {{ status_label }}
            </span>

            <div class="stylodyna-category-card__image-surface">
              {%- if block.settings.custom_image != blank -%}
                {{ block.settings.custom_image | image_url: width: 600 | image_tag:
                  loading: 'lazy',
                  class: 'stylodyna-category-card__image',
                  sizes: '(min-width: 1200px) 220px, (min-width: 750px) 240px, 45vw',
                  widths: '300, 450, 600',
                  alt: card_title
                }}
              {%- elsif block.settings.fallback_asset != blank -%}
                <img
                  src="{{ block.settings.fallback_asset | asset_url }}"
                  alt="{{ card_title | escape }}"
                  class="stylodyna-category-card__image"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- else -%}
                <div class="stylodyna-category-card__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>

            <div class="stylodyna-category-card__footer">
              <h3 class="stylodyna-category-card__title">{{ card_title | escape }}</h3>
              <span class="stylodyna-category-card__arrow" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_nav_buttons -%}
      <button
        type="button"
        class="stylodyna-categories__nav-btn stylodyna-categories__nav-btn--next"
        aria-label="Next categories"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {%- endif -%}

    <div class="stylodyna-categories__pagination" role="tablist" aria-label="Category pages"></div>
  </stylodyna-category-carousel>
</div>

{% schema %}
{
  "name": "Category Rail Carousel",
  "tag": "section",
  "class": "section-stylodyna-category-carousel",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "EXPLORE BY CATEGORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our Categories"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Browse specialized product lines tailored for modern living.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_nav_buttons",
      "label": "Show Desktop Arrow Controls",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Category"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Category Image"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Theme Fallback Asset Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Rail Carousel",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "title": "Women's Handbags",
            "fallback_asset": "sd-category-chair.webp"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Women's Accessories",
            "fallback_asset": "sd-category-sofa.webp"
          }
        }
      ]
    }
  ]
}
{% endschema %}
