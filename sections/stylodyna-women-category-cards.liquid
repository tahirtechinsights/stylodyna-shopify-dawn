{%- comment -%}
  StyloDyna Women Category Cards Component (CAT-UI-003D-R4B)
  2-Zone Warm Ivory Landscape Editorial Cards for Level-2 Women Audience Landing Page
{%- endcomment -%}

{{ 'component-stylodyna-women-categories.css' | asset_url | stylesheet_tag }}

<div class="stylodyna-women-categories page-width">
  <div class="stylodyna-women-categories__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="stylodyna-women-categories__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="stylodyna-women-categories__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="stylodyna-women-categories__description rte">
        {{ section.settings.description }}
      </div>
    {%- endif -%}
  </div>

  <ul class="stylodyna-women-categories__grid" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign card_title = block.settings.title
        assign is_available = false
        assign status_label = "COMING SOON"
        assign target_url = "javascript:void(0)"

        if block.settings.state == 'active'
          assign is_available = true
          assign status_label = "SHOP NOW"
          assign target_url = block.settings.custom_link | default: block.settings.collection.url | default: "/collections/womens-handbags"
        endif
      -%}

      <li class="stylodyna-women-categories__item" {{ block.shopify_attributes }}>
        <a
          href="{{ target_url }}"
          class="stylodyna-women-categories__card{% unless is_available %} stylodyna-women-categories__card--coming-soon{% endunless %}"
          {% unless is_available %}aria-disabled="true"{% endunless %}
        >
          {%- comment -%} Zone 1: Top Image Surface (~68% Height) {%- endcomment -%}
          <div class="stylodyna-women-categories__media">
            <span class="stylodyna-women-categories__badge {% if is_available %}stylodyna-women-categories__badge--available{% else %}stylodyna-women-categories__badge--coming-soon{% endif %}">
              {{ status_label }}
            </span>

            {%- if block.settings.custom_image != blank -%}
              {{ block.settings.custom_image | image_url: width: 800 | image_tag:
                loading: 'lazy',
                class: 'stylodyna-women-categories__img',
                alt: card_title
              }}
            {%- elsif block.settings.fallback_asset != blank -%}
              <img
                src="{{ block.settings.fallback_asset | asset_url }}"
                alt="{{ card_title | escape }}"
                class="stylodyna-women-categories__img"
                loading="lazy"
                width="800"
                height="500"
              >
            {%- endif -%}
          </div>

          {%- comment -%} Zone 2: Bottom Dedicated Content Area (Warm Ivory / Charcoal Typography) {%- endcomment -%}
          <div class="stylodyna-women-categories__content">
            <h3 class="stylodyna-women-categories__card-title">{{ card_title | escape }}</h3>
            <div class="stylodyna-women-categories__divider" aria-hidden="true"></div>
            {%- if is_available -%}
              <span class="stylodyna-women-categories__link">
                SHOP NOW
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            {%- else -%}
              <span class="stylodyna-women-categories__link stylodyna-women-categories__link--disabled" aria-disabled="true">
                In Development
              </span>
            {%- endif -%}
          </div>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Women Category Cards",
  "tag": "section",
  "class": "section-stylodyna-women-categories",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CURATED SELECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore our Women's lifestyle categories, crafted with exceptional quality and discreet presentation.</p>"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Women's Category"
        },
        {
          "type": "select",
          "id": "state",
          "label": "Availability State",
          "options": [
            { "value": "active", "label": "Active (Shop Now)" },
            { "value": "coming_soon", "label": "Coming Soon" }
          ],
          "default": "coming_soon"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Fallback Asset Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Women Category Cards",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "title": "Women's Handbags",
            "state": "active",
            "fallback_asset": "sd-cat-womens-handbags.jpg"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Women's Accessories",
            "state": "coming_soon",
            "fallback_asset": "sd-cat-womens-accessories.jpg"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Women's Undergarments",
            "state": "coming_soon",
            "fallback_asset": "sd-cat-womens-undergarments.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
