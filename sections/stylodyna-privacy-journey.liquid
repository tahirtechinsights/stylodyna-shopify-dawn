{%- comment -%}
  StyloDyna Reusable Assurance / Privacy Journey Section (CAT-UI-003D-R6)
  Editorial Warm Ivory Outer Container + Horizontal Connected Process Steps + Light Evidence Panel
{%- endcomment -%}

{{ 'component-stylodyna-privacy-journey.css' | asset_url | stylesheet_tag }}

<div class="stylodyna-privacy-journey page-width">
  {%- comment -%} Upper Split: Intro Left (30%) + Horizontal Connected Journey Steps Right (70%) {%- endcomment -%}
  <div class="stylodyna-privacy-journey__top-split">
    <div class="stylodyna-privacy-journey__intro">
      {%- if section.settings.eyebrow != blank -%}
        <div class="stylodyna-privacy-journey__eyebrow">
          <span class="stylodyna-privacy-journey__eyebrow-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </span>
          <span>{{ section.settings.eyebrow | escape }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="stylodyna-privacy-journey__heading">
          {{ section.settings.heading | escape | newline_to_br }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="stylodyna-privacy-journey__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Connected Process Steps Rail {%- endcomment -%}
    {%- assign step_count = section.blocks.size -%}
    {%- if step_count == 0 -%}
      {%- assign step_count = 4 -%}
    {%- endif -%}
    <div class="stylodyna-privacy-journey__steps" style="--step-count: {{ step_count }};">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="stylodyna-privacy-journey__step" {{ block.shopify_attributes }}>
            <div class="stylodyna-privacy-journey__step-header">
              <div class="stylodyna-privacy-journey__icon-circle">
                {%- case block.settings.icon -%}
                  {%- when 'package' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                  {%- when 'delivery' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="1" y="3" width="15" height="13"></rect>
                      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                      <circle cx="5.5" cy="18.5" r="2.5"></circle>
                      <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg>
                  {%- when 'invoice' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                  {%- when 'shield' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                  {%- else -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                      <line x1="3" y1="6" x2="21" y2="6"></line>
                      <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                {%- endcase -%}
              </div>
              <div class="stylodyna-privacy-journey__connector" aria-hidden="true"></div>
            </div>
            <div class="stylodyna-privacy-journey__step-num">{{ block.settings.step_number | default: forloop.index | escape }}</div>
            <h3 class="stylodyna-privacy-journey__step-title">{{ block.settings.title | escape }}</h3>
            <p class="stylodyna-privacy-journey__step-desc">{{ block.settings.description | escape }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Default 4-Step Journey Fallback {%- endcomment -%}
        <div class="stylodyna-privacy-journey__step">
          <div class="stylodyna-privacy-journey__step-header">
            <div class="stylodyna-privacy-journey__icon-circle">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
            </div>
            <div class="stylodyna-privacy-journey__connector" aria-hidden="true"></div>
          </div>
          <div class="stylodyna-privacy-journey__step-num">01</div>
          <h3 class="stylodyna-privacy-journey__step-title">DISCREET ORDER</h3>
          <p class="stylodyna-privacy-journey__step-desc">Order handled privately and discreetly from checkout to processing.</p>
        </div>

        <div class="stylodyna-privacy-journey__step">
          <div class="stylodyna-privacy-journey__step-header">
            <div class="stylodyna-privacy-journey__icon-circle">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <div class="stylodyna-privacy-journey__connector" aria-hidden="true"></div>
          </div>
          <div class="stylodyna-privacy-journey__step-num">02</div>
          <h3 class="stylodyna-privacy-journey__step-title">PRIVATE PACKAGING</h3>
          <p class="stylodyna-privacy-journey__step-desc">Items packed without visible external product or category disclosure.</p>
        </div>

        <div class="stylodyna-privacy-journey__step">
          <div class="stylodyna-privacy-journey__step-header">
            <div class="stylodyna-privacy-journey__icon-circle">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </div>
            <div class="stylodyna-privacy-journey__connector" aria-hidden="true"></div>
          </div>
          <div class="stylodyna-privacy-journey__step-num">03</div>
          <h3 class="stylodyna-privacy-journey__step-title">SEALED DELIVERY</h3>
          <p class="stylodyna-privacy-journey__step-desc">Dispatched in sealed outer company packaging so external handlers cannot identify parcel contents.</p>
        </div>

        <div class="stylodyna-privacy-journey__step">
          <div class="stylodyna-privacy-journey__step-header">
            <div class="stylodyna-privacy-journey__icon-circle">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>
            <div class="stylodyna-privacy-journey__connector" aria-hidden="true"></div>
          </div>
          <div class="stylodyna-privacy-journey__step-num">04</div>
          <h3 class="stylodyna-privacy-journey__step-title">INVOICE PRIVACY</h3>
          <p class="stylodyna-privacy-journey__step-desc">Order details communicated privately with the customer via designated support channels.</p>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Lower Light Photographic Evidence Panel {%- endcomment -%}
  <div class="stylodyna-privacy-journey__panel">
    <div class="stylodyna-privacy-journey__panel-content">
      <div class="stylodyna-privacy-journey__panel-header">
        <span class="stylodyna-privacy-journey__panel-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </span>
        <h3 class="stylodyna-privacy-journey__panel-title">
          {{ section.settings.panel_heading | default: 'Complete Privacy. Complete Peace of Mind.' | escape }}
        </h3>
      </div>
      <p class="stylodyna-privacy-journey__panel-desc">
        {{ section.settings.panel_description | default: 'Your order is packed with care in our company-sealed outer box. No visible product or category details appear on the outer packaging — designed for discreet delivery.' | escape }}
      </p>
    </div>

    <div class="stylodyna-privacy-journey__panel-media">
      {%- if section.settings.panel_image != blank -%}
        {{ section.settings.panel_image | image_url: width: 600 | image_tag:
          loading: 'lazy',
          class: 'stylodyna-privacy-journey__panel-img',
          alt: 'Sealed StyloDyna outer delivery box for discreet packaging'
        }}
      {%- else -%}
        <img src="{{ 'sd-privacy-sealed-outer-box.webp' | asset_url }}"
          alt="Sealed StyloDyna outer delivery box for discreet packaging"
          class="stylodyna-privacy-journey__panel-img"
          loading="lazy"
          width="600"
          height="338"
        >
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Assurance Privacy Journey",
  "tag": "section",
  "class": "section-stylodyna-privacy-journey",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "WOMEN'S UNDERGARMENTS PRIVACY JOURNEY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Your Privacy, Our Priority"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Section Description",
      "default": "<p>Designed to keep product details private throughout fulfillment. Packed in sealed outer packaging without visible product or category information.</p>"
    },
    {
      "type": "text",
      "id": "panel_heading",
      "label": "Bottom Panel Heading",
      "default": "Complete Privacy. Complete Peace of Mind."
    },
    {
      "type": "textarea",
      "id": "panel_description",
      "label": "Bottom Panel Description",
      "default": "Your order is packed with care in our company-sealed outer box. No visible product or category details appear on the outer packaging — designed for discreet delivery."
    },
    {
      "type": "image_picker",
      "id": "panel_image",
      "label": "Packaging Evidence Image"
    }
  ],
  "blocks": [
    {
      "type": "journey_step",
      "name": "Journey Step",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step Number",
          "default": "01"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Step Icon",
          "options": [
            {
              "value": "order",
              "label": "Discreet Order (Shopping Bag)"
            },
            {
              "value": "package",
              "label": "Private Packaging (Locked Box)"
            },
            {
              "value": "delivery",
              "label": "Sealed Delivery (Vehicle)"
            },
            {
              "value": "invoice",
              "label": "Invoice Privacy (Document)"
            },
            {
              "value": "shield",
              "label": "Privacy Shield"
            }
          ],
          "default": "order"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Concise explanation of this privacy stage."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Assurance Privacy Journey",
      "blocks": [
        {
          "type": "journey_step",
          "settings": {
            "step_number": "01",
            "icon": "order",
            "title": "DISCREET ORDER",
            "description": "Order handled privately and discreetly from checkout to processing."
          }
        },
        {
          "type": "journey_step",
          "settings": {
            "step_number": "02",
            "icon": "package",
            "title": "PRIVATE PACKAGING",
            "description": "Items packed without visible external product or category disclosure."
          }
        },
        {
          "type": "journey_step",
          "settings": {
            "step_number": "03",
            "icon": "delivery",
            "title": "SEALED DELIVERY",
            "description": "Dispatched in sealed outer company packaging so external handlers cannot identify parcel contents."
          }
        },
        {
          "type": "journey_step",
          "settings": {
            "step_number": "04",
            "icon": "invoice",
            "title": "INVOICE PRIVACY",
            "description": "Order details communicated privately with the customer via designated support channels."
          }
        }
      ]
    }
  ]
}
{% endschema %}
