{% comment %}theme-check-disable UndefinedObject{% endcomment %}
<!-- StyloDyna Featured Collections Section -->
{{ 'section-stylodyna-featured-collections.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    --columns-desktop: {{ section.settings.columns_desktop }};
    --columns-mobile: {{ section.settings.columns_mobile }};
    --card-gap: {{ section.settings.card_gap }}px;
    --image-radius: {{ section.settings.image_radius }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round: 0 }}px;
    }
  }

  @media screen and (min-width: 1200px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="stylodyna-featured-collections section-{{ section.id }}-padding">
  <div class="stylodyna-featured-collections__inner">
    
    <!-- Section Header -->
    <div class="stylodyna-featured-collections__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="stylodyna-featured-collections__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="stylodyna-featured-collections__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="stylodyna-featured-collections__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    <!-- Collection Grid -->
    <div class="stylodyna-featured-collections__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection_card' -%}
          {%- liquid
            assign card_collection = block.settings.collection
            assign card_title = block.settings.title | default: card_collection.title
            assign card_link = block.settings.link | default: card_collection.url | default: '/collections/all'
            assign card_subtitle = block.settings.subtitle | default: 'COLLECTION'
            assign card_focal = block.settings.image_focal_point | default: 'center'
            assign fallback_asset = ''

            case forloop.index
              when 1
                assign fallback_asset = 'sd-collection-living-room.webp'
                assign default_title = 'Living Room'
              when 2
                assign fallback_asset = 'sd-collection-bedroom.webp'
                assign default_title = 'Bedroom'
              when 3
                assign fallback_asset = 'sd-collection-dining.webp'
                assign default_title = 'Dining'
              when 4
                assign fallback_asset = 'sd-collection-home-office.webp'
                assign default_title = 'Home Office'
              when 5
                assign fallback_asset = 'sd-collection-lighting.webp'
                assign default_title = 'Lighting'
              when 6
                assign fallback_asset = 'sd-collection-wall-decor.webp'
                assign default_title = 'Wall Décor'
              when 7
                assign fallback_asset = 'sd-collection-storage.webp'
                assign default_title = 'Storage'
              when 8
                assign fallback_asset = 'sd-collection-outdoor.webp'
                assign default_title = 'Outdoor Living'
              else
                assign fallback_asset = 'sd-collection-living-room.webp'
                assign default_title = 'Collection'
            endcase

            if card_title == blank
              assign card_title = default_title
            endif
          -%}

          <a
            href="{{ card_link }}"
            class="stylodyna-featured-collections__card{% if section.settings.enable_hover_animation %} stylodyna-featured-collections__card--hover-enabled{% endif %}"
            {{ block.shopify_attributes }}
          >
            <!-- Media Container (4:5 Ratio) -->
            <div class="stylodyna-featured-collections__media" style="--image-focal: {{ card_focal }};">
              {%- if block.settings.image != blank -%}
                {%- assign img_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag:
                  loading: 'lazy',
                  width: block.settings.image.width,
                  height: img_height,
                  class: 'stylodyna-featured-collections__image',
                  widths: '375, 550, 750, 990, 1200',
                  alt: block.settings.alt_text | default: block.settings.image.alt | default: card_title | escape
                }}
              {%- elsif card_collection.featured_image != blank -%}
                {%- assign img_height = card_collection.featured_image.width | divided_by: card_collection.featured_image.aspect_ratio -%}
                {{ card_collection.featured_image | image_url: width: 1200 | image_tag:
                  loading: 'lazy',
                  width: card_collection.featured_image.width,
                  height: img_height,
                  class: 'stylodyna-featured-collections__image',
                  widths: '375, 550, 750, 990, 1200',
                  alt: card_collection.featured_image.alt | default: card_title | escape
                }}
              {%- else -%}
                <img
                  src="{{ fallback_asset | asset_url }}"
                  alt="{{ block.settings.alt_text | default: card_title | escape }}"
                  loading="lazy"
                  width="800"
                  height="1000"
                  class="stylodyna-featured-collections__image"
                >
              {%- endif -%}

              <!-- Overlay Gradient -->
              <div class="stylodyna-featured-collections__overlay"></div>
            </div>

            <!-- Content Overlay -->
            <div class="stylodyna-featured-collections__content">
              <h3 class="stylodyna-featured-collections__title">{{ card_title | escape }}</h3>
              <div class="stylodyna-featured-collections__meta">
                <span>{{ card_subtitle | escape }}</span>
                <span class="stylodyna-featured-collections__arrow" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
  "class": "section-stylodyna-featured-collections",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "SHOP BY COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Every Space"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Body Description",
      "default": "<p>Explore thoughtfully curated collections designed to bring timeless comfort and refined living into every corner of your home.</p>"
    },
    {
      "type": "header",
      "content": "Layout & Grid Settings"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Card Gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Card Corner Radius",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "enable_hover_animation",
      "label": "Enable Hover Animation",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top Padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "limit": 8,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title Override"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Label",
          "default": "COLLECTION"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "image_focal_point",
          "label": "Image Focal Position",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text Override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "title": "Living Room",
            "subtitle": "COLLECTION"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Bedroom",
            "subtitle": "COLLECTION"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Dining",
            "subtitle": "COLLECTION"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Home Office",
            "subtitle": "COLLECTION"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Lighting",
            "subtitle": "COLLECTION"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Wall Décor",
            "subtitle": "COLLECTION"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Storage",
            "subtitle": "COLLECTION"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Outdoor Living",
            "subtitle": "COLLECTION"
          }
        }
      ]
    }
  ]
}
{% endschema %}
