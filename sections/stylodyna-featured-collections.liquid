{% comment %}theme-check-disable UndefinedObject{% endcomment %}
<!-- StyloDyna Featured Collections & Real Product Grid Section -->
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-stylodyna-featured-collections.css' | asset_url | stylesheet_tag }}
{{ 'component-stylodyna-category-landing.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    --columns-desktop: {{ section.settings.columns_desktop | default: 4 }};
    --columns-mobile: {{ section.settings.columns_mobile | default: 1 }};
    --card-gap: {{ section.settings.card_gap | default: 24 }}px;
    --image-radius: {{ section.settings.image_radius | default: 6 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.8 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round: 0 }}px;
    }
  }

  @media screen and (min-width: 1200px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign featured_collection = section.settings.collection | default: collection
  assign products_to_show = section.settings.products_to_show | default: 4
  assign has_real_products = false
  assign product_count = 0

  if featured_collection != blank and featured_collection.products_count > 0
    assign has_real_products = true
    assign product_count = featured_collection.products_count
  endif
-%}

{%- if has_real_products or section.blocks.size > 0 -%}
<div class="stylodyna-featured-collections section-{{ section.id }}-padding">
  <div class="stylodyna-featured-collections__inner page-width">
    
    <!-- Section Header -->
    <div class="stylodyna-featured-collections__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="stylodyna-featured-collections__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="stylodyna-featured-collections__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="stylodyna-featured-collections__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    {%- if has_real_products -%}
      {%- if product_count == 1 -%}
        {%- assign single_product = featured_collection.products.first -%}
        <!-- CAT-UI-002J Premium Single Product State -->
        <div class="stylodyna-featured-product-single">
          <div class="stylodyna-featured-product-single__wrapper">
            <!-- Left: Contained Quiet Luxury Product Visual -->
            <div class="stylodyna-featured-product-single__media">
              {%- if single_product.featured_media -%}
                {{ single_product.featured_media | image_url: width: 1000 | image_tag:
                  loading: 'lazy',
                  class: 'stylodyna-featured-product-single__image stylodyna-featured-product-single__image--primary',
                  alt: single_product.title | escape
                }}
                {%- if single_product.media[1] != null -%}
                  {{ single_product.media[1] | image_url: width: 1000 | image_tag:
                    loading: 'lazy',
                    class: 'stylodyna-featured-product-single__image stylodyna-featured-product-single__image--secondary',
                    alt: single_product.title | escape
                  }}
                {%- endif -%}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- if single_product.compare_at_price > single_product.price and single_product.available -%}
                <span class="stylodyna-featured-product-single__sale-tag">Sale</span>
              {%- endif -%}
            </div>

            <!-- Right: Real Shopify Product Information -->
            <div class="stylodyna-featured-product-single__info">
              {%- if section.settings.show_vendor and single_product.vendor != blank -%}
                <p class="stylodyna-featured-product-single__vendor">{{ single_product.vendor | escape }}</p>
              {%- endif -%}

              <h3 class="stylodyna-featured-product-single__title">
                <a href="{{ single_product.url }}">{{ single_product.title | escape }}</a>
              </h3>

              <div class="stylodyna-featured-product-single__price-wrapper">
                <span class="stylodyna-featured-product-single__price">{{ single_product.price | money }}</span>
                {%- if single_product.compare_at_price > single_product.price -%}
                  <s class="stylodyna-featured-product-single__compare-price">{{ single_product.compare_at_price | money }}</s>
                {%- endif -%}
              </div>

              <div class="stylodyna-featured-product-single__availability">
                {%- if single_product.available -%}
                  <span class="stylodyna-featured-product-single__stock-status stylodyna-featured-product-single__stock-status--in-stock">In Stock</span>
                {%- else -%}
                  <span class="stylodyna-featured-product-single__stock-status stylodyna-featured-product-single__stock-status--sold-out">Sold Out</span>
                {%- endif -%}
              </div>

              {%- if single_product.description != blank -%}
                <div class="stylodyna-featured-product-single__description rte">
                  {{ single_product.description | strip_html | truncatewords: 28 }}
                </div>
              {%- endif -%}

              <div class="stylodyna-featured-product-single__actions">
                <a href="{{ single_product.url }}" class="stylodyna-category-hero__btn stylodyna-featured-product-single__btn">
                  View Product
                </a>
              </div>
            </div>
          </div>
        </div>
      {%- else -%}
        <!-- Multi-Product Scalable Grid -->
        <div class="grid product-grid contains-card contains-card--product grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down">
          {%- for product in featured_collection.products limit: products_to_show -%}
            <div class="grid__item">
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: 'portrait',
                show_secondary_image: true,
                show_vendor: section.settings.show_vendor,
                show_rating: false,
                section_id: section.id
              %}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <!-- Collection Card Blocks Fallback -->
      <div class="stylodyna-featured-collections__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection_card' -%}
            {%- liquid
              assign card_collection = block.settings.collection
              assign card_title = block.settings.title | default: card_collection.title
              assign card_link = block.settings.link | default: card_collection.url | default: '/collections/all'
              assign card_subtitle = block.settings.subtitle | default: 'COLLECTION'
              assign card_focal = block.settings.image_focal_point | default: 'center'
              assign fallback_asset = 'sd-collection-living-room.webp'
            -%}

            <a
              href="{{ card_link }}"
              class="stylodyna-featured-collections__card{% if section.settings.enable_hover_animation %} stylodyna-featured-collections__card--hover-enabled{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="stylodyna-featured-collections__media" style="--image-focal: {{ card_focal }};">
                {%- if block.settings.image != blank -%}
                  {%- assign img_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio -%}
                  {{ block.settings.image | image_url: width: 1200 | image_tag:
                    loading: 'lazy',
                    width: block.settings.image.width,
                    height: img_height,
                    class: 'stylodyna-featured-collections__image',
                    widths: '375, 550, 750, 990, 1200',
                    alt: block.settings.alt_text | default: block.settings.image.alt | default: card_title | escape
                  }}
                {%- elsif card_collection.featured_image != blank -%}
                  {%- assign img_height = card_collection.featured_image.width | divided_by: card_collection.featured_image.aspect_ratio -%}
                  {{ card_collection.featured_image | image_url: width: 1200 | image_tag:
                    loading: 'lazy',
                    width: card_collection.featured_image.width,
                    height: img_height,
                    class: 'stylodyna-featured-collections__image',
                    widths: '375, 550, 750, 990, 1200',
                    alt: card_collection.featured_image.alt | default: card_title | escape
                  }}
                {%- else -%}
                  <img
                    src="{{ fallback_asset | asset_url }}"
                    alt="{{ block.settings.alt_text | default: card_title | escape }}"
                    loading="lazy"
                    width="800"
                    height="1000"
                    class="stylodyna-featured-collections__image"
                  >
                {%- endif -%}
                <div class="stylodyna-featured-collections__overlay"></div>
              </div>

              <div class="stylodyna-featured-collections__content">
                <h3 class="stylodyna-featured-collections__title">{{ card_title | escape }}</h3>
                <div class="stylodyna-featured-collections__meta">
                  <span>{{ card_subtitle | escape }}</span>
                  <span class="stylodyna-featured-collections__arrow" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Featured Lifestyle",
  "tag": "section",
  "class": "section-stylodyna-featured-collections",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "FEATURED LIFESTYLE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New & Noteworthy"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Body Description",
      "default": "<p>Discover fresh arrivals and thoughtfully selected pieces for modern everyday style.</p>"
    },
    {
      "type": "header",
      "content": "Real Product Source"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection Source"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout & Grid Settings"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Card Gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Card Corner Radius",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "enable_hover_animation",
      "label": "Enable Hover Animation",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top Padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 112
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "limit": 8,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title Override"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Label",
          "default": "COLLECTION"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "image_focal_point",
          "label": "Image Focal Position",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text Override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Lifestyle",
      "blocks": []
    }
  ]
}
{% endschema %}
