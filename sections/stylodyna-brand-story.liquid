{% comment %}theme-check-disable UndefinedObject{% endcomment %}
<!-- StyloDyna Brand Story — Storefront Section -->
{{ 'section-stylodyna-brand-story.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.53 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.53 | round: 0 }}px;
    --brand-story-radius: {{ section.settings.image_radius }}px;
    --brand-story-focal: {{ section.settings.image_focal_point }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.73 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.73 | round: 0 }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="stylodyna-brand-story section-{{ section.id }}-padding">
  <div class="stylodyna-brand-story__inner">
    <div class="stylodyna-brand-story__grid{% if section.settings.image_position == 'right' %} stylodyna-brand-story__grid--right-image{% endif %}">
      
      <!-- Media Column -->
      <div class="stylodyna-brand-story__media-col">
        <div class="stylodyna-brand-story__media-wrapper">
          {%- if section.settings.image != blank -%}
            {%- assign img_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio -%}
            {{ section.settings.image | image_url: width: 1600 | image_tag:
              loading: 'lazy',
              width: section.settings.image.width,
              height: img_height,
              class: 'stylodyna-brand-story__image',
              widths: '375, 550, 750, 1100, 1400, 1600',
              alt: section.settings.image_alt_text | default: section.settings.image.alt | default: section.settings.heading | escape
            }}
          {%- else -%}
            <img
              src="{{ 'sd-brand-story-storefront.webp' | asset_url }}"
              alt="{{ section.settings.image_alt_text | default: 'StyloDyna concept storefront presenting a premium home décor and furniture marketplace.' | escape }}"
              loading="lazy"
              width="1600"
              height="1200"
              class="stylodyna-brand-story__image"
            >
          {%- endif -%}
        </div>
      </div>

      <!-- Content Column -->
      <div class="stylodyna-brand-story__content-col">
        {%- if section.settings.eyebrow != blank -%}
          <p class="stylodyna-brand-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="stylodyna-brand-story__heading">
            {{ section.settings.heading | escape | newline_to_br }}
          </h2>
        {%- endif -%}

        <div class="stylodyna-brand-story__text-body rte">
          {%- if section.settings.main_text != blank -%}
            {{ section.settings.main_text }}
          {%- endif -%}

          {%- if section.settings.supporting_text != blank -%}
            {{ section.settings.supporting_text }}
          {%- endif -%}
        </div>

        {%- if section.settings.button_label != blank -%}
          <div class="stylodyna-brand-story__button-wrapper">
            <a
              {% if section.settings.button_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link }}"
              {% endif %}
              class="button button--primary stylodyna-brand-story__button"
            >
              <span>{{ section.settings.button_label | escape }}</span>
              <span class="svg-wrapper stylodyna-brand-story__btn-arrow">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand Story",
  "tag": "section",
  "class": "section-stylodyna-brand-story",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom Image"
    },
    {
      "type": "text",
      "id": "image_alt_text",
      "label": "Image Alt Text",
      "default": "StyloDyna concept storefront presenting a premium home décor and furniture marketplace."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_focal_point",
      "label": "Image Focal Position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Image Corner Radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for Homes, Crafted for Living."
    },
    {
      "type": "richtext",
      "id": "main_text",
      "label": "Main Paragraph",
      "default": "<p>StyloDyna was created with a simple belief: every home should reflect the people who live in it. Inspired by timeless British design and contemporary Scandinavian simplicity, we curate furniture and décor that bring warmth, comfort, and refined character to everyday living.</p>"
    },
    {
      "type": "richtext",
      "id": "supporting_text",
      "label": "Supporting Paragraph",
      "default": "<p>Every collection is selected with thoughtful design, quality craftsmanship, and real-life functionality at its core.</p>"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top Padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
