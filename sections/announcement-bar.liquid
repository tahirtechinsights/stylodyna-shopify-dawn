{% comment %}theme-check-disable UndefinedObject{% endcomment %}
<!-- StyloDyna Two-Tier Global Communication System -->
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-stylodyna-header.css' | asset_url | stylesheet_tag }}

<!-- TIER 1: UTILITY / CONTACT BAR -->
{%- if section.settings.enable_utility_bar -%}
  <div class="stylodyna-utility-bar" role="region" aria-label="Customer Support Bar">
    <div class="stylodyna-utility-bar__inner">
      
      <!-- Desktop Contact View -->
      <div class="stylodyna-utility-bar__desktop">
        {%- if section.settings.show_phone and section.settings.phone_number != blank -%}
          <a href="tel:{{ section.settings.phone_number | replace: ' ', '' }}" class="stylodyna-utility-bar__item">
            <span>{{ section.settings.phone_label | default: 'Customer Care' | escape }}: {{ section.settings.phone_number | escape }}</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_whatsapp and section.settings.whatsapp_url != blank -%}
          {%- if section.settings.show_phone and section.settings.phone_number != blank -%}
            <span class="stylodyna-utility-bar__divider" aria-hidden="true">·</span>
          {%- endif -%}
          <a href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener" class="stylodyna-utility-bar__item">
            <span>{{ section.settings.whatsapp_label | default: 'WhatsApp Support' | escape }}</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_email and section.settings.email_address != blank -%}
          {%- if section.settings.show_phone or section.settings.show_whatsapp -%}
            <span class="stylodyna-utility-bar__divider" aria-hidden="true">·</span>
          {%- endif -%}
          <a href="mailto:{{ section.settings.email_address }}" class="stylodyna-utility-bar__item">
            <span>{{ section.settings.email_address | escape }}</span>
          </a>
        {%- endif -%}
      </div>

      <!-- Mobile Streamlined Contact View -->
      <div class="stylodyna-utility-bar__mobile">
        {%- if section.settings.show_whatsapp and section.settings.whatsapp_url != blank -%}
          <a href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener" class="stylodyna-utility-bar__item">
            <span>{{ section.settings.whatsapp_label | default: 'WhatsApp Support' | escape }}</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_phone and section.settings.phone_number != blank -%}
          {%- if section.settings.show_whatsapp -%}
            <span class="stylodyna-utility-bar__divider" aria-hidden="true">·</span>
          {%- endif -%}
          <a href="tel:{{ section.settings.phone_number | replace: ' ', '' }}" class="stylodyna-utility-bar__item">
            <span>{{ section.settings.phone_number | escape }}</span>
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
{%- endif -%}

<!-- TIER 2: DYNAMIC ANNOUNCEMENT BAR -->
{%- if section.blocks.size > 0 -%}
  <div class="stylodyna-announcement-bar">
    <div class="stylodyna-announcement-bar__inner">
      {%- if section.blocks.size == 1 -%}
        <div class="stylodyna-announcement-bar__content" role="region" aria-label="Announcement" {{ section.blocks.first.shopify_attributes }}>
          <p class="stylodyna-announcement-bar__message">
            {%- if section.blocks.first.settings.link != blank -%}
              <a href="{{ section.blocks.first.settings.link }}" class="stylodyna-announcement-bar__link">
                {{ section.blocks.first.settings.text | escape }}
              </a>
            {%- else -%}
              <span>{{ section.blocks.first.settings.text | escape }}</span>
            {%- endif -%}
          </p>
        </div>
      {%- else -%}
        <slideshow-component
          class="slideshow-component"
          role="region"
          aria-roledescription="Carousel"
          aria-label="Announcements"
        >
          <div class="stylodyna-announcement-bar__slider-wrapper slider-buttons">
            
            {%- if section.settings.show_nav_buttons -%}
              <button
                type="button"
                class="stylodyna-announcement-bar__nav-btn slider-button slider-button--prev"
                name="previous"
                aria-label="Previous Announcement"
                aria-controls="Slider-{{ section.id }}"
              >
                <span class="svg-wrapper">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7.5 1.5L3 6L7.5 10.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
            {%- endif -%}

            <div
              class="grid grid--1-col slider slider--everywhere"
              id="Slider-{{ section.id }}"
              aria-live="polite"
              aria-atomic="true"
              data-autoplay="{{ section.settings.auto_rotate }}"
              data-speed="{{ section.settings.change_slides_speed }}"
            >
              {%- for block in section.blocks -%}
                <div
                  class="slideshow__slide slider__slide grid__item grid--1-col"
                  id="Slide-{{ section.id }}-{{ forloop.index }}"
                  {{ block.shopify_attributes }}
                  role="group"
                  aria-roledescription="Announcement"
                  aria-label="{{ forloop.index }} of {{ forloop.length }}"
                  tabindex="-1"
                >
                  <div class="stylodyna-announcement-bar__content">
                    <p class="stylodyna-announcement-bar__message">
                      {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}" class="stylodyna-announcement-bar__link">
                          {{ block.settings.text | escape }}
                        </a>
                      {%- else -%}
                        <span>{{ block.settings.text | escape }}</span>
                      {%- endif -%}
                    </p>
                  </div>
                </div>
              {%- endfor -%}
            </div>

            {%- if section.settings.show_nav_buttons -%}
              <button
                type="button"
                class="stylodyna-announcement-bar__nav-btn slider-button slider-button--next"
                name="next"
                aria-label="Next Announcement"
                aria-controls="Slider-{{ section.id }}"
              >
                <span class="svg-wrapper">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.5 1.5L9 6L4.5 10.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
            {%- endif -%}

          </div>
        </slideshow-component>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement & Utility",
  "max_blocks": 8,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Tier 1: Utility Contact Bar Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_utility_bar",
      "label": "Enable Utility Bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show Phone Number",
      "default": true
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone Label",
      "default": "Customer Care"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "0327 1777879"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp Support",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp Label",
      "default": "WhatsApp Support"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "WhatsApp Destination URL"
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show Email Address",
      "default": true
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Email Address",
      "default": "sales@stylodyna.com"
    },
    {
      "type": "header",
      "content": "Tier 2: Dynamic Announcement Settings"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate Announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotation Speed Interval",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_nav_buttons",
      "label": "Show Navigation Arrows",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Fast & Reliable Delivery Across Pakistan",
          "label": "Announcement Message"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Announcement Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement & Utility",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Fast & Reliable Delivery Across Pakistan"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Free Delivery on Selected Products"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Confident in Our Quality · Easy Returns If You’re Not Satisfied"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "WhatsApp Support Available 24/7 · 0327 1777879"
          }
        }
      ]
    }
  ]
}
{% endschema %}
