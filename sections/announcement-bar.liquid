{% comment %}theme-check-disable UndefinedObject{% endcomment %}
<!-- StyloDyna Global Utility Bar & Continuous Announcement Ticker (HEADER-001 Canonical WhatsApp Implementation) -->
{{ 'component-stylodyna-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'stylodyna-header.js' | asset_url }}" defer="defer"></script>

{%- assign raw_whatsapp_num = section.settings.whatsapp_number | default: '923271777879' | strip | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' -%}
{%- assign raw_whatsapp_msg = section.settings.whatsapp_message | default: "Hello StyloDyna! I'm interested in a product and would like some assistance." -%}
{%- assign encoded_whatsapp_msg = raw_whatsapp_msg | url_encode -%}
{%- capture whatsapp_url -%}https://wa.me/{{ raw_whatsapp_num }}?text={{ encoded_whatsapp_msg }}{%- endcapture -%}

<!-- TIER 1: UTILITY / CONTACT, LIVE STATUS & SOCIAL BAR (THREE-REGION GRID) -->
{%- if section.settings.enable_utility_bar -%}
  <div class="stylodyna-utility-bar" role="region" aria-label="Customer Support & Live Status Bar">
    <div class="stylodyna-utility-bar__inner page-width">
      
      <!-- LEFT REGION: CONTACT GROUP + INLINE EXPAND TRIGGER -->
      <div class="stylodyna-utility-bar__contact-group">
        {%- if section.settings.show_phone and section.settings.phone_number != blank -%}
          <a href="tel:{{ section.settings.phone_number | replace: ' ', '' }}" class="stylodyna-utility-bar__item stylodyna-utility-bar__item--phone" aria-label="Call StyloDyna: {{ section.settings.phone_number | escape }}">
            <span class="stylodyna-utility-bar__icon-wrapper">{% render 'icon-stylodyna-phone' %}</span>
            <span class="stylodyna-utility-bar__label stylodyna-utility-bar__desktop-only">{{ section.settings.phone_number | escape }}</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_whatsapp -%}
          {%- if section.settings.show_phone and section.settings.phone_number != blank -%}
            <span class="stylodyna-utility-bar__divider" aria-hidden="true">·</span>
          {%- endif -%}
          <div class="stylodyna-whatsapp-wrapper">
            <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" class="stylodyna-utility-bar__item stylodyna-utility-bar__item--whatsapp" aria-haspopup="true" aria-label="StyloDyna WhatsApp Support">
              <span class="stylodyna-utility-bar__icon-wrapper">{% render 'icon-stylodyna-whatsapp' %}</span>
              <span class="stylodyna-utility-bar__label stylodyna-utility-bar__desktop-only">WHATSAPP</span>
            </a>

            <!-- Desktop Customer Assistance Popover -->
            <div class="stylodyna-whatsapp-popover stylodyna-utility-bar__desktop-only" role="dialog" aria-label="WhatsApp Support">
              <div class="stylodyna-whatsapp-popover__header">
                <span class="stylodyna-whatsapp-popover__brand-icon">
                  {% render 'icon-stylodyna-whatsapp' %}
                </span>
                <span class="stylodyna-whatsapp-popover__title">WhatsApp StyloDyna</span>
              </div>
              <p class="stylodyna-whatsapp-popover__desc">Need help choosing a product?<br>Our team is ready to assist.</p>
              <div class="stylodyna-whatsapp-popover__qr-box">
                <img src="{{ 'stylodyna-whatsapp-qr.svg' | asset_url }}" width="128" height="128" alt="QR code to chat with StyloDyna on WhatsApp" loading="lazy" class="stylodyna-whatsapp-popover__qr-img">
              </div>
              <span class="stylodyna-whatsapp-popover__scan-text">Scan to chat on WhatsApp</span>
              <div class="stylodyna-whatsapp-popover__divider"></div>
              <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" class="stylodyna-whatsapp-popover__action">
                <span>Continue on WhatsApp Web</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.show_email and section.settings.email_address != blank -%}
          {%- if section.settings.show_phone or section.settings.show_whatsapp -%}
            <span class="stylodyna-utility-bar__divider stylodyna-utility-bar__divider--email" aria-hidden="true">·</span>
          {%- endif -%}
          <div class="stylodyna-utility-bar__email-container" data-stylodyna-email-container>
            <a href="mailto:{{ section.settings.email_address }}" class="stylodyna-utility-bar__item stylodyna-utility-bar__item--email" id="stylodyna-email-trigger" aria-label="Email StyloDyna: {{ section.settings.email_address | escape }}">
              <span class="stylodyna-utility-bar__icon-wrapper">{% render 'icon-stylodyna-email' %}</span>
              <span class="stylodyna-utility-bar__email-text stylodyna-utility-bar__desktop-only">{{ section.settings.email_address | escape }}</span>
            </a>
            <!-- MICRO EMAIL POPOVER -->
            <div class="stylodyna-email-popover stylodyna-utility-bar__desktop-only" id="stylodyna-email-popover" role="dialog" aria-label="StyloDyna Email Contact">
              <span class="stylodyna-email-popover__title">Email Us</span>
              <a href="mailto:{{ section.settings.email_address }}" class="stylodyna-email-popover__link">{{ section.settings.email_address | escape }}</a>
              <span class="stylodyna-email-popover__desc">We typically reply within one business day.</span>
              <a href="mailto:{{ section.settings.email_address }}" class="stylodyna-email-popover__action">
                <span>Compose Email</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        {%- endif -%}

        <!-- INLINE HORIZONTAL EXPAND TRIGGER (>>) -->
        <button type="button" class="stylodyna-utility-expand-trigger" id="stylodyna-utility-expand-trigger" aria-expanded="false" aria-controls="stylodyna-utility-expand-panel" aria-label="Expand Utility Navigation">
          <span class="stylodyna-utility-expand-trigger__icon" aria-hidden="true">»</span>
        </button>

        <!-- INLINE HORIZONTAL EXPANDABLE PANEL -->
        <div class="stylodyna-utility-expand-panel" id="stylodyna-utility-expand-panel" role="region" aria-label="Utility Links Menu">
          <div class="stylodyna-utility-expand-panel__content">
            {%- if section.settings.show_email and section.settings.email_address != blank -%}
              <a href="mailto:{{ section.settings.email_address }}" class="stylodyna-utility-expand__item stylodyna-utility-expand__item--email">
                {% render 'icon-stylodyna-email' %}
                <span>{{ section.settings.email_address | escape }}</span>
              </a>
              <span class="stylodyna-utility-expand__divider" aria-hidden="true">|</span>
            {%- endif -%}
            <a href="/pages/showrooms" class="stylodyna-utility-expand__item">Visit Our Showrooms</a>
            <span class="stylodyna-utility-expand__divider" aria-hidden="true">|</span>
            <span class="stylodyna-utility-expand__text">Mon–Sun: 10AM–9PM</span>
            <span class="stylodyna-utility-expand__divider" aria-hidden="true">|</span>
            <a href="/collections/new-arrivals" class="stylodyna-utility-expand__item">New Arrivals</a>
            <span class="stylodyna-utility-expand__divider" aria-hidden="true">|</span>
            <a href="/pages/track-order" class="stylodyna-utility-expand__item">Track Order</a>
            <span class="stylodyna-utility-expand__divider" aria-hidden="true">|</span>
            <a href="/pages/contact" class="stylodyna-utility-expand__item">Help & Support</a>
          </div>
          <button type="button" class="stylodyna-utility-expand-close" id="stylodyna-utility-expand-close" aria-label="Close Expanded Utility Menu">
            <span>Close</span>
            <span aria-hidden="true">×</span>
          </button>
        </div>
      </div>

      <!-- CENTER REGION: INDIVISIBLE LIVE GREEN DOT + ROTATING MESSAGE UNIT -->
      <div class="stylodyna-utility-bar__live" data-stylodyna-utility-rotator data-interval="7000" tabindex="0" id="stylodyna-live-rotator">
        <span class="stylodyna-utility-bar__live-dot" aria-hidden="true"></span>
        <div class="stylodyna-utility-bar__live-message-wrapper" id="stylodyna-live-message-wrapper">
          <span class="stylodyna-utility-bar__live-text is-active" data-utility-message>Welcome to StyloDyna — Designed for Homes, Crafted for Living.</span>
          <span class="stylodyna-utility-bar__live-text" data-utility-message>Same-Day Delivery & Assembly Available in Lahore.</span>
          <span class="stylodyna-utility-bar__live-text" data-utility-message>Need Help? Our Team Is Just a WhatsApp Away.</span>
          <span class="stylodyna-utility-bar__live-text" data-utility-message>StyloDyna Showrooms Are Coming Soon to Lahore.</span>
          <span class="stylodyna-utility-bar__live-text" data-utility-message>Coming Soon to DHA & Bahria Town, Lahore.</span>
        </div>
        <!-- MICRO FULL-MESSAGE POPOVER (SHOWN ONLY WHEN TRUNCATED) -->
        <div class="stylodyna-message-popover" id="stylodyna-message-popover" role="tooltip" aria-hidden="true">
          <span class="stylodyna-message-popover__content" id="stylodyna-message-popover-text">Welcome to StyloDyna — Designed for Homes, Crafted for Living.</span>
        </div>
      </div>

      <!-- RIGHT REGION: SOCIAL MEDIA GROUP (CONFIGURED OR PREVIEW MODE) -->
      <div class="stylodyna-utility-bar__social-group stylodyna-utility-bar__desktop-only">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" class="stylodyna-utility-social__link" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        {%- elsif section.settings.show_unconfigured_social_icons -%}
          <span class="stylodyna-utility-social__link stylodyna-utility-social__link--disabled" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </span>
        {%- endif -%}

        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" class="stylodyna-utility-social__link" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        {%- elsif section.settings.show_unconfigured_social_icons -%}
          <span class="stylodyna-utility-social__link stylodyna-utility-social__link--disabled" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </span>
        {%- endif -%}

        {%- if settings.social_youtube_link != blank -%}
          <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" class="stylodyna-utility-social__link" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
          </a>
        {%- elsif section.settings.show_unconfigured_social_icons -%}
          <span class="stylodyna-utility-social__link stylodyna-utility-social__link--disabled" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
          </span>
        {%- endif -%}
      </div>
    </div>

    <!-- DEDICATED STYLODYNA CHARCOAL MOBILE UTILITY DISCLOSURE DRAWER (< 990px) -->
    <div class="stylodyna-mobile-utility-drawer" id="stylodyna-mobile-utility-drawer" role="dialog" aria-modal="true" aria-label="StyloDyna Mobile Utility Navigation">
      <div class="stylodyna-mobile-utility-drawer__header">
        <span class="stylodyna-mobile-utility-drawer__title">Utility Menu</span>
        <button type="button" class="stylodyna-mobile-utility-drawer__close" id="stylodyna-mobile-utility-close" aria-label="Close Mobile Utility Menu">×</button>
      </div>
      <div class="stylodyna-mobile-utility-drawer__body">
        {%- if section.settings.show_email and section.settings.email_address != blank -%}
          <a href="mailto:{{ section.settings.email_address }}" class="stylodyna-mobile-utility-drawer__link stylodyna-mobile-utility-drawer__link--email">
            {% render 'icon-stylodyna-email' %}
            <span>{{ section.settings.email_address | escape }}</span>
          </a>
        {%- endif -%}
        <a href="/pages/showrooms" class="stylodyna-mobile-utility-drawer__link">
          <span>Visit Our Showrooms</span>
          <span aria-hidden="true">›</span>
        </a>
        <div class="stylodyna-mobile-utility-drawer__info">
          <span>Mon–Sun: 10AM–9PM</span>
        </div>
        <a href="/collections/new-arrivals" class="stylodyna-mobile-utility-drawer__link">
          <span>New Arrivals</span>
          <span aria-hidden="true">›</span>
        </a>
        <a href="/pages/track-order" class="stylodyna-mobile-utility-drawer__link">
          <span>Track Your Order</span>
          <span aria-hidden="true">›</span>
        </a>
        <a href="/pages/contact" class="stylodyna-mobile-utility-drawer__link">
          <span>Help & Support</span>
          <span aria-hidden="true">›</span>
        </a>
        <div class="stylodyna-mobile-utility-drawer__socials">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

<!-- TIER 2: CONTINUOUS ANNOUNCEMENT TICKER -->
<div class="stylodyna-ticker-bar" role="region" aria-label="Announcements Ticker">
  <div class="stylodyna-ticker-bar__track-wrapper">
    <div class="stylodyna-ticker-bar__track">
      <div class="stylodyna-ticker-bar__content">
        <span>Fast & Reliable Delivery Across Pakistan</span>
        <span class="stylodyna-ticker-bar__dot" aria-hidden="true">·</span>
        <span>Free Delivery on Selected Products</span>
        <span class="stylodyna-ticker-bar__dot" aria-hidden="true">·</span>
        <span>Confident in Our Quality · Easy Returns If You’re Not Satisfied</span>
        <span class="stylodyna-ticker-bar__dot" aria-hidden="true">·</span>
        <span>WhatsApp Support Available 24/7 · 0327 1777879</span>
        <span class="stylodyna-ticker-bar__dot" aria-hidden="true">·</span>
      </div>
      <!-- Duplicate content block for seamless looping -->
      <div class="stylodyna-ticker-bar__content" aria-hidden="true">
        <span>Fast & Reliable Delivery Across Pakistan</span>
        <span class="stylodyna-ticker-bar__dot" aria-hidden="true">·</span>
        <span>Free Delivery on Selected Products</span>
        <span class="stylodyna-ticker-bar__dot" aria-hidden="true">·</span>
        <span>Confident in Our Quality · Easy Returns If You’re Not Satisfied</span>
        <span class="stylodyna-ticker-bar__dot" aria-hidden="true">·</span>
        <span>WhatsApp Support Available 24/7 · 0327 1777879</span>
        <span class="stylodyna-ticker-bar__dot" aria-hidden="true">·</span>
      </div>
    </div>
  </div>
</div>

<!-- GLOBAL FLOATING WHATSAPP CTA -->
{% render 'stylodyna-floating-whatsapp' %}

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_utility_bar",
      "default": true,
      "label": "Enable Utility Contact Bar"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "default": true,
      "label": "Show Phone Number"
    },
    {
      "type": "text",
      "id": "phone_number",
      "default": "0327 1777879",
      "label": "Phone Number"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "default": true,
      "label": "Show WhatsApp Support"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "default": "923271777879",
      "label": "WhatsApp Phone Number (digits only, e.g. 923271777879)"
    },
    {
      "type": "textarea",
      "id": "whatsapp_message",
      "default": "Hello StyloDyna! I'm interested in a product and would like some assistance.",
      "label": "WhatsApp Default Message"
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "default": true,
      "label": "Show Sales Email"
    },
    {
      "type": "text",
      "id": "email_address",
      "default": "sales@stylodyna.com",
      "label": "Sales Email Address"
    },
    {
      "type": "checkbox",
      "id": "show_unconfigured_social_icons",
      "default": true,
      "label": "Show unconfigured social icons for visual layout preview"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Fast & Reliable Delivery Across Pakistan",
          "label": "Announcement Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Announcement Link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}
