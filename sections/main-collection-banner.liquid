{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

{%- assign hero_image = collection.metafields.custom.hero_banner_image.value -%}
{%- if hero_image == blank and collection.image != blank -%}
  {%- assign hero_image = collection.image -%}
{%- endif -%}

{%- assign show_image = false -%}
{%- if section.settings.show_collection_image or template.suffix == 'decor-family' -%}
  {%- assign show_image = true -%}
{%- endif -%}

<div class="collection-hero{% if show_image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient">
  {% render 'breadcrumbs' %}
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      {%- if section.settings.eyebrow != blank -%}
        <p class="collection-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- elsif template.suffix == 'decor-family' -%}
        <p class="collection-hero__eyebrow">DECOR COLLECTION</p>
      {%- endif -%}
      <h1 class="collection-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>

      {%- if section.settings.show_collection_description and collection.description != blank -%}
        <div class="collection-hero__description rte">{{ collection.description }}</div>
      {%- endif -%}

      {% render 'child-collection-nav' %}
    </div>

    {%- if show_image -%}
      <div class="collection-hero__image-container media gradient">
        {%- if hero_image != blank -%}
          <img
            srcset="
              {%- if hero_image.width >= 165 -%}{{ hero_image | image_url: width: 165 }} 165w,{%- endif -%}
              {%- if hero_image.width >= 360 -%}{{ hero_image | image_url: width: 360 }} 360w,{%- endif -%}
              {%- if hero_image.width >= 535 -%}{{ hero_image | image_url: width: 535 }} 535w,{%- endif -%}
              {%- if hero_image.width >= 750 -%}{{ hero_image | image_url: width: 750 }} 750w,{%- endif -%}
              {%- if hero_image.width >= 1070 -%}{{ hero_image | image_url: width: 1070 }} 1070w,{%- endif -%}
              {%- if hero_image.width >= 1500 -%}{{ hero_image | image_url: width: 1500 }} 1500w,{%- endif -%}
              {{ hero_image | image_url }} {{ hero_image.width }}w
            "
            src="{{ hero_image | image_url: width: 750 }}"
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
            alt="{{ hero_image.alt | default: collection.title | escape }}"
            width="{{ hero_image.width | default: 900 }}"
            height="{{ hero_image.height | default: 600 }}"
          >
        {%- else -%}
          <img
            src="{{ 'sd-decor-hero.webp' | asset_url }}"
            alt="{{ collection.title | escape }}"
            loading="lazy"
            width="900"
            height="600"
          >
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
