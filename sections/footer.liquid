{% comment %}theme-check-disable UndefinedObject{% endcomment %}
<!-- StyloDyna Custom Footer -->
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer--{{ section.id }} {
    --sd-footer-bg: {% if section.settings.footer_background != blank %}{{ section.settings.footer_background }}{% else %}#1F1F1F{% endif %};
    --sd-footer-heading: {% if section.settings.heading_color != blank %}{{ section.settings.heading_color }}{% else %}#FAF9F5{% endif %};
    --sd-footer-text: {% if section.settings.footer_text_color != blank %}{{ section.settings.footer_text_color }}{% else %}#CCCCCC{% endif %};
    --sd-footer-link: rgba(255, 255, 255, 0.75);
    --sd-footer-link-hover: #FFFFFF;
    --sd-footer-border: rgba(255, 255, 255, 0.12);
    --sd-footer-width: {{ section.settings.container_width }}px;
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .footer--{{ section.id }} .stylodyna-footer__inner {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer--{{ section.id }} {
      margin-top: {{ section.settings.margin_top }}px;
    }
    .footer--{{ section.id }} .stylodyna-footer__inner {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign has_social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank and settings.social_linkedin_link == blank
    assign has_social_icons = false
  endif
-%}

<footer class="footer footer--{{ section.id }} color-{{ section.settings.color_scheme }} gradient" role="contentinfo">
  <div class="page-width stylodyna-footer__inner">
    <div class="stylodyna-footer__grid">
      <!-- Column 1: Store Branding & Contact Details -->
      <section class="stylodyna-footer__column stylodyna-footer__contact" aria-label="{{ section.settings.contact_heading | escape }}">
        <div class="stylodyna-footer__brand">
          {%- if section.settings.logo != blank -%}
            {%- assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio -%}
            {{ section.settings.logo | image_url: width: 300 | image_tag:
              class: 'stylodyna-footer__logo-mark',
              widths: '50, 100, 150, 200, 300',
              width: section.settings.logo_width,
              height: logo_height,
              loading: 'lazy',
              alt: shop.name
            }}
          {%- else -%}
            <img
              src="{{ 'stylodyna-logo-mark-gold-footer.png' | asset_url }}"
              class="stylodyna-footer__logo-mark"
              width="38"
              height="38"
              loading="lazy"
              alt="{{ shop.name | escape }}"
            >
          {%- endif -%}
          {%- if section.settings.store_name != blank -%}
            <h2 class="stylodyna-footer__store-name">{{ section.settings.store_name | escape }}</h2>
          {%- endif -%}
        </div>

        <div class="stylodyna-footer__contact-details rte">
          {%- if section.settings.address != blank -%}
            <p class="stylodyna-footer__address">{{ section.settings.address | newline_to_br }}</p>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <p class="stylodyna-footer__phone">
              <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' | escape }}">{{ section.settings.phone | escape }}</a>
            </p>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <p class="stylodyna-footer__email">
              <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
            </p>
          {%- endif -%}
          {%- if section.settings.sales_email != blank -%}
            <p class="stylodyna-footer__email stylodyna-footer__email--sales">
              <a href="mailto:{{ section.settings.sales_email | escape }}">{{ section.settings.sales_email | escape }}</a>
            </p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_social and has_social_icons -%}
          {%- render 'social-icons', class: 'footer__list-social stylodyna-footer__social' -%}
        {%- endif -%}
      </section>

      <!-- Column 2: Company Navigation -->
      <nav class="stylodyna-footer__column stylodyna-footer__nav" aria-label="{{ section.settings.company_heading | default: 'Company' | escape }}">
        {%- if section.settings.company_heading != blank -%}
          <h2 class="stylodyna-footer__heading">{{ section.settings.company_heading | escape }}</h2>
        {%- endif -%}
        <ul class="list-unstyled stylodyna-footer__menu" role="list">
          {%- if section.settings.company_menu != blank and section.settings.company_menu.links.size > 0 -%}
            {%- for link in section.settings.company_menu.links -%}
              <li>
                <a class="link stylodyna-footer__link" href="{{ link.url }}">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li><a class="link stylodyna-footer__link" href="#">About Us</a></li>
            <li><a class="link stylodyna-footer__link" href="#">Our Stores</a></li>
            <li><a class="link stylodyna-footer__link" href="#">Contact Us</a></li>
          {%- endif -%}
        </ul>
      </nav>

      <!-- Column 3: Customer Service Navigation -->
      <nav class="stylodyna-footer__column stylodyna-footer__nav" aria-label="{{ section.settings.service_heading | default: 'Customer Service' | escape }}">
        {%- if section.settings.service_heading != blank -%}
          <h2 class="stylodyna-footer__heading">{{ section.settings.service_heading | escape }}</h2>
        {%- endif -%}
        <ul class="list-unstyled stylodyna-footer__menu" role="list">
          {%- if section.settings.service_menu != blank and section.settings.service_menu.links.size > 0 -%}
            {%- for link in section.settings.service_menu.links -%}
              <li>
                <a class="link stylodyna-footer__link" href="{{ link.url }}">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li><a class="link stylodyna-footer__link" href="#">Privacy Policy</a></li>
            <li><a class="link stylodyna-footer__link" href="#">Refund Policy</a></li>
            <li><a class="link stylodyna-footer__link" href="#">Shipping &amp; Return</a></li>
            <li><a class="link stylodyna-footer__link" href="#">Terms &amp; Conditions</a></li>
            <li><a class="link stylodyna-footer__link" href="#">FAQs</a></li>
            <li><a class="link stylodyna-footer__link" href="#">Store Locations</a></li>
          {%- endif -%}
        </ul>
      </nav>

      <!-- Column 4: Newsletter Subscription Form -->
      <section class="stylodyna-footer__column stylodyna-footer__newsletter" aria-label="{{ section.settings.newsletter_heading | escape }}">
        {%- if section.settings.newsletter_heading != blank -%}
          <h2 class="stylodyna-footer__heading">{{ section.settings.newsletter_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.newsletter_description != blank -%}
          <div class="stylodyna-footer__newsletter-description rte">
            {{ section.settings.newsletter_description }}
          </div>
        {%- endif -%}
        {%- if section.settings.newsletter_enable -%}
          {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form stylodyna-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter-form__field-wrapper stylodyna-footer__newsletter-fields">
              <div class="field stylodyna-footer__field">
                <input
                  id="NewsletterForm--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="field__input stylodyna-footer__input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="ContactFooter-error"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="ContactFooter-success"
                  {% endif %}
                  placeholder="Email address"
                  required
                >
                <label class="field__label stylodyna-footer__label visually-hidden" for="NewsletterForm--{{ section.id }}">Email address</label>
                <button
                  type="submit"
                  class="newsletter-form__button field__button stylodyna-footer__button"
                  name="commit"
                  id="Subscribe"
                  aria-label="{{ 'newsletter.button_label' | t }}"
                >
                  SUBSCRIBE
                </button>
              </div>
              {%- if form.errors -%}
                <small class="newsletter-form__message form__message" id="ContactFooter-error">
                  <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                  {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
                </small>
              {%- endif -%}
            </div>
            {%- if form.posted_successfully? -%}
              <h3
                class="newsletter-form__message newsletter-form__message--success form__message"
                id="ContactFooter-success"
                tabindex="-1"
                autofocus
              >
                <span class="svg-wrapper">{{- 'icon-success.svg' | inline_asset_content -}}</span>
                {{- 'newsletter.success' | t -}}
              </h3>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </section>
    </div>
  </div>

  <!-- Bottom Bar: Selectors, Copyright, Payment Icons -->
  <div class="stylodyna-footer__bottom">
    <div class="page-width stylodyna-footer__bottom-inner">
      <div class="stylodyna-footer__localization isolate">
        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body visually-hidden" id="FooterLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body visually-hidden" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>

      <p class="stylodyna-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: shop.name | escape }}. {{ section.settings.copyright_suffix | escape }}
      </p>

      {%- if section.settings.payment_enable -%}
        {%- liquid
          assign show_payment_row = false
          assign payment_types_to_render = ''
          if shop.enabled_payment_types.size > 0
            assign show_payment_row = true
            assign payment_types_to_render = shop.enabled_payment_types
          elsif section.settings.payment_fallback_enable
            assign show_payment_row = true
            assign payment_types_to_render = section.settings.payment_fallback_types | split: ','
          endif
        -%}
        {%- if show_payment_row -%}
          <div class="footer__payment stylodyna-footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in payment_types_to_render -%}
                {%- assign clean_type = type | strip -%}
                {%- if clean_type != blank -%}
                  <li class="list-payment__item">
                    {{ clean_type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>

  <!-- Back To Top Button -->
  {%- if section.settings.enable_back_to_top -%}
    <button
      type="button"
      class="stylodyna-back-to-top"
      data-stylodyna-back-to-top
      aria-label="{{ section.settings.back_to_top_label | escape }}"
      hidden
    >
      <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
    </button>

    <script>
      (() => {
        const button = document.querySelector('[data-stylodyna-back-to-top]');
        if (!button || button.dataset.stylodynaBound) return;
        button.dataset.stylodynaBound = 'true';
        const toggle = () => {
          if (window.scrollY > 300) {
            button.removeAttribute('hidden');
            button.classList.add('is-visible');
          } else {
            button.setAttribute('hidden', '');
            button.classList.remove('is-visible');
          }
        };
        window.addEventListener('scroll', toggle, { passive: true });
        toggle();
        button.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "StyloDyna footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Column 1: Store & Contact"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Store Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 30,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Logo width",
      "default": 38
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name Fallback",
      "default": "StyloDyna"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact Column ARIA Label",
      "default": "Contact information"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "First Floor, Jasmine Mall Sector C, Bahria Town Lahore"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+92 327 1777879"
    },
    {
      "type": "text",
      "id": "email",
      "label": "General / Contact Email Address",
      "default": "contact@stylodyna.com"
    },
    {
      "type": "text",
      "id": "sales_email",
      "label": "Sales Email Address",
      "default": "sale@stylodyna.com"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Column 2: Company Menu"
    },
    {
      "type": "text",
      "id": "company_heading",
      "label": "Company Heading",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company Menu"
    },
    {
      "type": "header",
      "content": "Column 3: Customer Service Menu"
    },
    {
      "type": "text",
      "id": "service_heading",
      "label": "Customer Service Heading",
      "default": "Customer Service"
    },
    {
      "type": "link_list",
      "id": "service_menu",
      "label": "Customer Service Menu"
    },
    {
      "type": "header",
      "content": "Column 4: Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Enable Newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Subscribe to StyloDyna"
    },
    {
      "type": "richtext",
      "id": "newsletter_description",
      "label": "Newsletter Description",
      "default": "<p>Discover new arrivals, curated collections, styling inspiration and selected offers.</p>"
    },
    {
      "type": "header",
      "content": "Bottom Bar & Payment Icons"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable Language Selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable Country / Currency Selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "payment_fallback_enable",
      "label": "Enable Fallback Payment Icons when Store Gateways Empty",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_fallback_types",
      "label": "Fallback Payment Types (Comma-separated)",
      "default": "visa,master,discover,western_union,american_express,cirrus,paypal"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright Store Name",
      "default": "StyloDyna"
    },
    {
      "type": "text",
      "id": "copyright_suffix",
      "label": "Copyright Text Suffix",
      "default": "All Rights Reserved"
    },
    {
      "type": "header",
      "content": "Style & Layout Settings"
    },
    {
      "type": "color",
      "id": "footer_background",
      "label": "Footer Background Color",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "footer_text_color",
      "label": "Footer Text Color",
      "default": "#CCCCCC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#FAF9F5"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 960,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container Width",
      "default": 1200
    },
    {
      "type": "checkbox",
      "id": "enable_back_to_top",
      "label": "Enable Back To Top Button",
      "default": true
    },
    {
      "type": "text",
      "id": "back_to_top_label",
      "label": "Back To Top Button Label",
      "default": "Back to top"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "StyloDyna footer"
    }
  ]
}
{% endschema %}
